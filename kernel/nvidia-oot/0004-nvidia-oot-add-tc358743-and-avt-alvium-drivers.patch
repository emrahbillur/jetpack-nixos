+static int avt_core_ops_reset(struct v4l2_subdev *sd, u32 val)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(sd);
+
+	dev_info(&client->dev, "%s[%d]+ %s", __func__, __LINE__, __FILE__);
+
+	return 0;

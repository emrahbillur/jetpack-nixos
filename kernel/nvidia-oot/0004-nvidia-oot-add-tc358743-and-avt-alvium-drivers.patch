+static int tc358743_dv_timings_cap(struct v4l2_subdev *sd,
+                                   struct v4l2_dv_timings_cap *cap) {
+  v4l2_info(sd, "Calling %s\n", __FUNCTION__);
+  if (cap && cap->pad != 0) return -EINVAL;
+
+  *cap = tc358743_timings_cap;
+
+  return 0;
+}
